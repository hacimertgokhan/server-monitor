{
  "name": "server-monitor",
  "version": "0.4.0",
  "description": "Live SSH server monitor for Windows, macOS and Linux: flowchart dashboard as a window, mini widget or live desktop wallpaper",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "promo": "node scripts/promo/make-promo.mjs",
    "promo:stills": "node scripts/promo/make-promo.mjs --stills",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "author": {
    "name": "Hacı Mert Gökhan",
    "email": "hacimertgokhan@gmail.com",
    "url": "https://hacimertgokhan.com"
  },
  "license": "MIT",
  "homepage": "https://hacimertgokhan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hacimertgokhan/server-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/hacimertgokhan/server-monitor/issues"
  },
  "keywords": [
    "ssh",
    "server-monitoring",
    "monitoring",
    "dashboard",
    "electron",
    "react",
    "typescript",
    "docker",
    "pm2",
    "systemd",
    "wallpaper",
    "live-wallpaper",
    "windows",
    "devops",
    "sysadmin",
    "macos",
    "linux",
    "cross-platform",
    "logs"
  ],
  "engines": {
    "node": ">=22"
  }
}
